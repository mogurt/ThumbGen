{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThumbGen batch manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "jobs"],
  "properties": {
    "schema_version": {"const": 1},
    "defaults": {"$ref": "#/$defs/options"},
    "execution": {"$ref": "#/$defs/execution"},
    "jobs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "input", "outputs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "input": {"type": "string", "minLength": 1},
          "sequence_id": {"type": "string", "minLength": 1},
          "options": {"$ref": "#/$defs/options"},
          "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/output"}}
        }
      }
    }
  },
  "$defs": {
    "execution": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "workers": {"type": "integer", "minimum": 1, "maximum": 256},
        "thread_budget": {"type": "integer", "minimum": 1, "maximum": 256},
        "memory_budget_mib": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "startup_timeout_ms": {"type": "integer", "minimum": 1, "maximum": 86400000},
        "task_timeout_ms": {"type": "integer", "minimum": 0, "maximum": 86400000}
      },
      "allOf": [{
        "if": {"required": ["workers"], "properties": {"workers": {"minimum": 2}}},
        "then": {"required": ["thread_budget", "memory_budget_mib"], "properties": {"memory_budget_mib": {"minimum": 1}}}
      }]
    },
    "size": {
      "oneOf": [
        {"type": "integer", "minimum": 1, "maximum": 32768},
        {"type": "array", "prefixItems": [
          {"type": "integer", "minimum": 1, "maximum": 32768},
          {"type": "integer", "minimum": 1, "maximum": 32768}
        ], "minItems": 2, "maxItems": 2}
      ]
    },
    "format": {"enum": ["jpeg", "jpg", "png", "webp"]},
    "quality": {"type": "integer", "minimum": 1, "maximum": 100},
    "options": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "preset": {"enum": ["fast", "balanced", "quality"]},
        "background": {"enum": ["black", "white", "transparent"]},
        "input_space": {"type": "string", "minLength": 1},
        "ocio_config": {"type": "string"},
        "display": {"type": "string"}, "view": {"type": "string"},
        "channels": {"type": "string"},
        "part_name": {"type": "string", "minLength": 1},
        "selection_policy": {"enum": ["primary", "root_rgb"]},
        "deep_mode": {"enum": ["reject", "flatten"]},
        "deep_samples_per_pixel": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "visualization": {"enum": ["auto", "colour", "depth", "normal", "vector", "id", "id_rgb", "cryptomatte"]},
        "data_range": {"type": "array", "items": {"type": "number"}, "maxItems": 2, "anyOf": [{"maxItems": 0}, {"minItems": 2}]},
        "invalid_values": {"enum": ["black", "magenta", "error"]},
        "part": {"type": "integer", "minimum": -1, "maximum": 2147483647},
        "threads": {"type": "integer", "minimum": 1, "maximum": 256},
        "max_decode_mib": {"type": "integer", "minimum": 1, "maximum": 16384},
        "format": {"$ref": "#/$defs/format"},
        "quality": {"$ref": "#/$defs/quality"}, "size": {"$ref": "#/$defs/size"},
        "existing": {"enum": ["error", "skip", "replace"]}
      }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size": {"$ref": "#/$defs/size"}, "format": {"$ref": "#/$defs/format"},
        "quality": {"$ref": "#/$defs/quality"},
        "existing": {"enum": ["error", "skip", "replace"]}
      }
    }
  }
}
