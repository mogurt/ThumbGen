# skcms is vendored, immutable, and always linked statically. Only its Windows
# translation units use clang-cl; the project's selected compiler is unchanged.
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/dependencies/versions.json" _skcms_lock)
string(JSON _skcms_count LENGTH "${_skcms_lock}" skcms files)
math(EXPR _skcms_last "${_skcms_count}-1")
set(_skcms_root "${CMAKE_CURRENT_SOURCE_DIR}/third_party/skcms")
set(_skcms_inputs)
foreach(_i RANGE ${_skcms_last})
    string(JSON _file MEMBER "${_skcms_lock}" skcms files ${_i})
    string(JSON _expected GET "${_skcms_lock}" skcms files "${_file}")
    file(SHA256 "${_skcms_root}/${_file}" _actual)
    if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "Vendored skcms source differs: ${_file}")
    endif()
    list(APPEND _skcms_inputs "${_skcms_root}/${_file}")
endforeach()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${_skcms_inputs})
if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR NOT CMAKE_SYSTEM_PROCESSOR MATCHES "AMD64|amd64|x86_64|X86_64")
    message(FATAL_ERROR "The skcms baseline is currently validated for x64 only")
endif()
if(MSVC)
    get_filename_component(_vc_tools "${CMAKE_CXX_COMPILER}" DIRECTORY)
    find_program(THUMBGEN_CLANG_CL clang-cl HINTS "${_vc_tools}/../../../../../Llvm/x64/bin"
        "$ENV{ProgramFiles}/Microsoft Visual Studio/2022/Community/VC/Tools/Llvm/x64/bin" REQUIRED)
    set(_objects)
    foreach(_source skcms.cc src/skcms_TransformBaseline.cc src/skcms_TransformHsw.cc)
        get_filename_component(_name "${_source}" NAME_WE)
        set(_object "${CMAKE_CURRENT_BINARY_DIR}/skcms/$<CONFIG>/${_name}.obj")
        set(_simd)
        if(_name STREQUAL "skcms_TransformHsw")
            set(_simd /clang:-mavx2 /clang:-mf16c)
        endif()
        add_custom_command(OUTPUT "${_object}"
            COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/skcms/$<CONFIG>"
            COMMAND "${THUMBGEN_CLANG_CL}" /nologo /c /O2 /MD /std:c++17 /DSKCMS_DISABLE_SKX=1
                /clang:-march=x86-64 ${_simd} "${_skcms_root}/${_source}" "/Fo${_object}"
            DEPENDS ${_skcms_inputs} VERBATIM)
        list(APPEND _objects "${_object}")
    endforeach()
    add_library(thumbgen_skcms STATIC ${_objects})
    set_target_properties(thumbgen_skcms PROPERTIES LINKER_LANGUAGE CXX)
else()
    add_library(thumbgen_skcms STATIC "${_skcms_root}/skcms.cc"
        "${_skcms_root}/src/skcms_TransformBaseline.cc" "${_skcms_root}/src/skcms_TransformHsw.cc")
    target_compile_features(thumbgen_skcms PRIVATE cxx_std_17)
    target_compile_definitions(thumbgen_skcms PRIVATE SKCMS_DISABLE_SKX=1)
    target_compile_options(thumbgen_skcms PRIVATE -O2 -march=x86-64 -fno-fast-math)
    set_property(SOURCE "${_skcms_root}/src/skcms_TransformHsw.cc" APPEND PROPERTY COMPILE_OPTIONS -mavx2 -mf16c)
endif()
target_include_directories(thumbgen_skcms PUBLIC "${_skcms_root}")
install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/dependencies/notices/skcms-BSD-3-Clause.txt" DESTINATION share/ThumbGen/notices)
