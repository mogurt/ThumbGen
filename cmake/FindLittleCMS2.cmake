find_path(LittleCMS2_INCLUDE_DIR lcms2.h REQUIRED)
find_library(LittleCMS2_LIBRARY NAMES lcms2 REQUIRED)
file(STRINGS "${LittleCMS2_INCLUDE_DIR}/lcms2.h" LittleCMS2_VERSION_LINE REGEX "^#define LCMS_VERSION[ ]+2200")
if(NOT LittleCMS2_VERSION_LINE)
    message(FATAL_ERROR "LittleCMS2 2.20 (LCMS_VERSION=2200) headers required")
endif()
add_library(LittleCMS2::LittleCMS2 UNKNOWN IMPORTED)
set_target_properties(LittleCMS2::LittleCMS2 PROPERTIES IMPORTED_LOCATION "${LittleCMS2_LIBRARY}" INTERFACE_INCLUDE_DIRECTORIES "${LittleCMS2_INCLUDE_DIR}")
# CMake's UNKNOWN import library needs the runtime DLL directory separately.
if(WIN32)
    get_filename_component(LittleCMS2_PREFIX "${LittleCMS2_INCLUDE_DIR}" DIRECTORY)
    find_file(LittleCMS2_RUNTIME NAMES lcms2.dll lcms2-2.dll PATHS "${LittleCMS2_PREFIX}/bin" NO_DEFAULT_PATH REQUIRED)
    get_filename_component(LittleCMS2_RUNTIME_DIR "${LittleCMS2_RUNTIME}" DIRECTORY)
endif()
