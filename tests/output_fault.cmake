# A separate core copy: production thumbgen_core never has fault hooks.
get_target_property(fault_sources thumbgen_core SOURCES)
add_library(thumbgen_output_fault_core STATIC ${fault_sources})
foreach(property IN ITEMS COMPILE_DEFINITIONS COMPILE_OPTIONS INCLUDE_DIRECTORIES)
    get_target_property(value thumbgen_core ${property})
    if(value)
        set_property(TARGET thumbgen_output_fault_core PROPERTY ${property} "${value}")
    endif()
endforeach()
get_target_property(fault_links thumbgen_core LINK_LIBRARIES)
if(THUMBGEN_C2_PNG_STREAM)
    add_library(thumbgen_output_fault_c2 STATIC src/c2_resize.cpp)
    target_compile_features(thumbgen_output_fault_c2 PRIVATE cxx_std_20)
    get_target_property(c2_options thumbgen_c2 COMPILE_OPTIONS)
    target_compile_options(thumbgen_output_fault_c2 PRIVATE ${c2_options})
    target_compile_definitions(thumbgen_output_fault_c2 PRIVATE THUMBGEN_OUTPUT_FAULT_TESTS=1)
    target_link_libraries(thumbgen_output_fault_c2 PRIVATE OpenImageIO::OpenImageIO)
    list(REMOVE_ITEM fault_links thumbgen_c2)
    list(APPEND fault_links thumbgen_output_fault_c2)
endif()
target_link_libraries(thumbgen_output_fault_core PRIVATE ${fault_links})
target_compile_features(thumbgen_output_fault_core PUBLIC cxx_std_17)
target_compile_definitions(thumbgen_output_fault_core PRIVATE THUMBGEN_OUTPUT_FAULT_TESTS=1)
add_executable(thumbgen_output_fault_tests tests/test_output_fault.cpp)
target_include_directories(thumbgen_output_fault_tests PRIVATE include src)
target_compile_definitions(thumbgen_output_fault_tests PRIVATE THUMBGEN_OUTPUT_FAULT_TESTS=1)
target_link_libraries(thumbgen_output_fault_tests PRIVATE thumbgen_output_fault_core OpenImageIO::OpenImageIO nlohmann_json::nlohmann_json)
if(MSVC)
    target_compile_options(thumbgen_output_fault_tests PRIVATE /utf-8)
endif()
if(THUMBGEN_C2_PNG_STREAM)
    target_compile_definitions(thumbgen_output_fault_tests PRIVATE THUMBGEN_EXPECT_C2=1)
endif()
add_test(NAME core_output_fault COMMAND thumbgen_output_fault_tests)
set_tests_properties(core_output_fault PROPERTIES TIMEOUT 240 LABELS "protocol;allocation;regression")
