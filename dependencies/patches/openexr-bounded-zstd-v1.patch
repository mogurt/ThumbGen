+/* ThumbGen bounded decoder v1: only the v2 pipeline owns this state.
+ * Legacy ABI callers retain their previous TLS behavior. Encoding is unchanged.
+ * All v2 allocations, including the ZSTD DCtx, use the context allocator.
+ * Byte shuffle uses unaligned loads, so context alignment is sufficient. */
+static void* bounded_zstd_alloc (void* opaque, size_t size)
+{
+    return ((exr_const_context_t) opaque)->alloc_fn (size);
+}
+static void bounded_zstd_free (void* opaque, void* address)
+{
+    if (address) ((exr_const_context_t) opaque)->free_fn (address);
+}
+static void bounded_zstd_destroy (exr_decode_pipeline_t* decode)
+{
+    exr_zstd_tls_state* state = (exr_zstd_tls_state*) decode->compression_context;
+    if (!state) return;
+    if (state->dctx) ZSTD_freeDCtx (state->dctx);
+    if (state->shuffle_buf) decode->context->free_fn (state->shuffle_buf);
+    decode->context->free_fn (state);
+    decode->compression_context = NULL;
+    decode->free_compression_context = NULL;
+}
+static exr_result_t bounded_zstd_resources (
+    exr_decode_pipeline_t* decode, size_t required, exr_zstd_tls_state** result)
+{
+    exr_const_context_t ctxt = decode->context;
+    exr_zstd_tls_state* state;
+    if (decode->compression_context &&
+        decode->free_compression_context != bounded_zstd_destroy)
+        return EXR_ERR_INVALID_ARGUMENT;
+    state = (exr_zstd_tls_state*) decode->compression_context;
+    if (!state)
+    {
+        state = (exr_zstd_tls_state*) ctxt->alloc_fn (sizeof (*state));
+        if (!state) return EXR_ERR_OUT_OF_MEMORY;
+        memset (state, 0, sizeof (*state));
+        decode->compression_context = state;
+        decode->free_compression_context = bounded_zstd_destroy;
+    }
+    if (!state->dctx)
+    {
+        ZSTD_customMem mem = {bounded_zstd_alloc, bounded_zstd_free, (void*) ctxt};
+        state->dctx = ZSTD_createDCtx_advanced (mem);
+        if (!state->dctx) return EXR_ERR_OUT_OF_MEMORY;
+    }
+    if (required > state->shuffle_buf_size)
+    {
+        /* Release before growing; no uncharged overshoot or realloc overlap. */
+        if (state->shuffle_buf) ctxt->free_fn (state->shuffle_buf);
+        state->shuffle_buf = NULL;
+        state->shuffle_buf_size = 0;
+        state->shuffle_buf = (uint8_t*) ctxt->alloc_fn (required);
+        if (!state->shuffle_buf) return EXR_ERR_OUT_OF_MEMORY;
+        state->shuffle_buf_size = required;
+    }
+    *result = state;
+    return EXR_ERR_SUCCESS;
+}
